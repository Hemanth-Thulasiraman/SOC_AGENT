ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# soc-agent-db (pgvector/pgvector:pg16, docker):
#   docker run -d --name soc-agent-db \
#     -e POSTGRES_PASSWORD=devpassword -e POSTGRES_DB=soc_agent \
#     -p 5433:5432 -v soc_agent_pgdata:/var/lib/postgresql/data \
#     pgvector/pgvector:pg16
# Port is 5433, not Postgres's default 5432 -- check `lsof -nP -iTCP:5432
# -sTCP:LISTEN` first if 5432 looks free on your machine, a native/Homebrew
# Postgres install silently intercepted it during initial setup here.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=soc_agent
DB_USER=postgres
DB_PASSWORD=devpassword
